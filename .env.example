# Postgres (Supabase). Use the POOLED connection string (port 6543, "Transaction" mode) when
# deployed to a serverless host (Vercel etc.): Project Settings > Database > Connection pooling.
DATABASE_URL=

# AI provider (Groq, OpenAI-compatible). Without a key the app still runs: documents the template
# parser can read work, and every AI step reports that it could not run.
GROQ_API_KEY=

# Optional: override which model each role uses (defaults are in lib/agent/llm.ts).
# Hosted model ids get retired without notice; if a step starts failing with "Model ... is not
# available (HTTP 404)", set the variable the message names.
# EXTRACTOR_MODEL=
# INVESTIGATOR_MODEL=
# VERIFIER_MODEL=
# EXPLAIN_MODEL=
# LLM_REASONING_EFFORT=low

# Embeddings for the near-duplicate check (OpenAI).
OPENAI_API_KEY=

# Optional: Telegram notifications for invoices that need review.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NEXT_PUBLIC_APP_URL=

# Optional: run everything in a separate schema of the same database (the test suite and
# `npm run dev:demo` do this for you). Never set it to the live schema's name by hand.
# DB_SCHEMA=

# Sign-in. With VERIBOOK_USERS set, every API request needs a signed-in account, and human
# decisions are recorded under the account's name (so "a different person must sign off" compares
# real accounts). Names must be unique. Make each passwordHash with:  npm run auth:hash -- '<password>'
# VERIBOOK_USERS=[{"username":"priya","name":"Priya Shah","passwordHash":"scrypt$..."},{"username":"sam","name":"Sam Lee","passwordHash":"scrypt$..."}]
# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
# VERIBOOK_AUTH_SECRET=
# Leave both unset and VeriBook runs open (no sign-in), in development and production alike: an
# open proof of concept, entered straight from the home page. VERIBOOK_AUTH=off forces it open
# even if accounts are listed.
# VERIBOOK_AUTH=off
