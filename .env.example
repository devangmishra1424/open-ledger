# Postgres (Supabase). Use the POOLED connection string (port 6543, "Transaction" mode) when
# deployed to a serverless host (Vercel etc.): Project Settings > Database > Connection pooling.
DATABASE_URL=

# AI provider (Groq, OpenAI-compatible). Without a key the app still runs: documents the template
# parser can read work, and every AI step reports that it could not run.
GROQ_API_KEY=

# Optional: override which model each role uses (defaults are in lib/agent/llm.ts).
# Hosted model ids get retired without notice; if a step starts failing with "Model ... is not
# available (HTTP 404)", set the variable the message names.
# EXTRACTOR_MODEL=
# INVESTIGATOR_MODEL=
# VERIFIER_MODEL=
# EXPLAIN_MODEL=
# LLM_REASONING_EFFORT=low

# Embeddings for the near-duplicate check (OpenAI).
OPENAI_API_KEY=

# Optional: Telegram notifications for invoices that need review.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NEXT_PUBLIC_APP_URL=

# Optional: run everything in a separate schema of the same database (the test suite and
# `npm run dev:demo` do this for you). Never set it to the live schema's name by hand.
# DB_SCHEMA=
