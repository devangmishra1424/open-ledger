{
  "name": "open-ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:web": "npm --prefix frontend ci && npm --prefix frontend run build && node scripts/copy-web.cjs",
    "build": "npm run build:web && next build",
    "start": "next start",
    "migrate": "tsx --env-file=.env db/migrate.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "generate-pdfs": "tsx --env-file=.env scripts/generate_demo_pdfs.ts",
    "test": "vitest run",
    "dev:demo": "node scripts/dev-demo.cjs",
    "migrate:apply": "tsx --env-file=.env db/apply-migration.ts",
    "auth:hash": "tsx scripts/hash-password.ts",
    "bench:llm": "tsx --env-file=.env scripts/llm-bench.ts",
    "typecheck": "tsc --noEmit",
    "reader": "node scripts/run-reader.cjs",
    "eval:documents": "tsx --env-file=.env eval/documents/run.ts",
    "eval:decisions": "tsx --env-file=.env eval/decisions/run.ts"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "fast-json-stable-stringify": "2.1.0",
    "munkres-js": "1.2.2",
    "next": "15.5.25",
    "openai": "^7.10.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "postgres": "3.4.9",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.23",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.13",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
